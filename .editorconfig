# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.kt]
indent_size = 4

[*.kts]
indent_size = 4

[*.java]
indent_size = 4

[*.xml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.bat]
end_of_line = crlf
