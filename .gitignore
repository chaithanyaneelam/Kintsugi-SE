# =============================================================================
# Kintsugi Sanctuary — Root Git Ignore Specification
# =============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
*.tmp
*.bak
*.orig
*.iml
.classpath
.project
.settings/

# Environment Variable & Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Logs & Temporary Data
*.log
logs/
temp/
tmp/
cache/
.cache/

# Python / Backend Ignores
backend/venv/
backend/.venv/
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
backend/*/*/*/__pycache__/
backend/*.pyc
backend/*.pyo
backend/*.pyd
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/dist/
backend/build/
backend/*.egg-info/

# Web / Node Ignores
web/node_modules/
web/dist/
web/build/
web/.output/
web/.next/
web/coverage/
web/.eslintcache

# Android / Frontend Ignores
frontend/.gradle/
frontend/build/
frontend/app/build/
frontend/app/captures/
frontend/local.properties
frontend/.navigation/
frontend/*.ap_
frontend/*.apk
frontend/*.aab
frontend/*.dex
frontend/.kotlin/

# Database / Export Backups
database/backups/*.sql
exports/*.pdf
exports/*.json
uploads/*
!uploads/.gitkeep
!exports/.gitkeep
!logs/.gitkeep
