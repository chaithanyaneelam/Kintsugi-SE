# =============================================================================
# Kintsugi Web Frontend Environment Configuration Template
# Copy this file to '.env' before running Vite dev or building for production
# =============================================================================

# Base API & WebSocket URLs
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_WS_BASE_URL="ws://localhost:8000/api/v1/ws"

# Application Metadata
VITE_APP_TITLE="Kintsugi — Mindfulness & Emotional Sanctuary"
VITE_APP_VERSION="1.0.0"

# Features & Analytics Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_AI_COMPANION=true
