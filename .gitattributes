# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit LF line endings for shell scripts and config files
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.sql text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.keystore binary
