<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0819"
    android:fitsSystemWindows="true">

    <com.kintsugi.app.core.ui.widget.AnimatedBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.kintsugi.app.core.ui.widget.FloatingParticlesView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.kintsugi.app.core.ui.widget.KintsugiToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:subtitle="Verification Code"
            app:title="Verify Security Code" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <com.kintsugi.app.core.ui.widget.GlassCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Enter Verification Code"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_otp_sent_to"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:text="We sent a 6-digit security code to your email address."
                            android:textColor="#C9B8FF"
                            android:textSize="14sp" />

                        <!-- 6 Digit OTP Entry -->
                        <com.kintsugi.app.core.ui.widget.PremiumTextField
                            android:id="@+id/et_otp_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:hint="6-Digit Verification Code"
                            android:inputType="number" />

                        <TextView
                            android:id="@+id/tv_resend_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="16dp"
                            android:text="Resend code in 60s"
                            android:textColor="#8B88A0"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btn_resend_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:padding="6dp"
                            android:text="Resend Verification Code"
                            android:textColor="#A855F7"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <com.kintsugi.app.core.ui.widget.PrimaryGradientButton
                            android:id="@+id/btn_verify_otp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="Verify Code ✦" />

                    </LinearLayout>
                </com.kintsugi.app.core.ui.widget.GlassCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
