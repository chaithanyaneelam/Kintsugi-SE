<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="32dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/gold_accent_alpha30"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_quote_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="“"
            android:textColor="@color/luxury_gold"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_affirmation_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            tools:text="Healing takes time, and every small step matters." />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:background="@color/luxury_gold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="✦ AFFIRMATION"
            android:textColor="@color/luxury_gold"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
