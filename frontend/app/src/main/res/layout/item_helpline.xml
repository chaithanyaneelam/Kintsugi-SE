<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#1A1232"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="#2E224D"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_mood_tag_chip"
            android:backgroundTint="#21173D">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_phone_call"
                app:tint="#A855F7" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_helpline_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                tools:text="Tele-MANAS (Mental Health Helpline)" />

            <TextView
                android:id="@+id/tv_helpline_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#34D399"
                android:textSize="12sp"
                tools:text="24/7 • Free &amp; Confidential" />

            <TextView
                android:id="@+id/tv_helpline_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="#C9B8FF"
                android:textSize="13sp"
                tools:text="14416 • English, Hindi, Telugu" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_call_helpline"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="16dp"
            android:text="CALL"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#A855F7"
            app:cornerRadius="21dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
