<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:fitsSystemWindows="true">

    <!-- Animated Particle & Gradient Background Surface -->
    <com.kintsugi.app.core.ui.widget.AnimatedBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.kintsugi.app.core.ui.widget.FloatingParticlesView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Global Kintsugi Toolbar Component -->
        <com.kintsugi.app.core.ui.widget.KintsugiToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:subtitle="Sanctuary &amp; Philosophy"
            app:title="About Kintsugi" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="64dp">

                <!-- 1. Hero Header Card (32dp Radius) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_hero_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="6dp"
                    app:strokeColor="@color/gold_accent_alpha30"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <com.kintsugi.app.core.ui.widget.KintsugiLogoView
                            android:id="@+id/about_logo"
                            android:layout_width="80dp"
                            android:layout_height="80dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="serif"
                            android:text="Kintsugi"
                            android:textColor="@color/luxury_gold"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-light"
                            android:text="Healing, one moment at a time."
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:textStyle="italic" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Disclaimer Card (28dp Radius) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_disclaimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/amber_warning"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_mood_tag_chip"
                            android:gravity="center"
                            android:text="🛡️"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:text="Kintsugi supports emotional wellbeing, but it is not a replacement for licensed mental healthcare or emergency services."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 3. What is Kintsugi? Card (28dp Radius) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_philosophy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/gold_accent_alpha30"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:text="WHAT IS KINTSUGI?"
                            android:textColor="@color/luxury_gold"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-light"
                            android:lineSpacingExtra="4dp"
                            android:text="Kintsugi (金継ぎ, 'golden joinery') is the traditional Japanese art of repairing broken pottery with lacquer dusted or mixed with powdered gold. Rather than disguising cracks, it embraces them as part of the object's history—making it even more beautiful because of its imperfections."
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Our Mission Card (28dp Radius) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/gold_accent_alpha30"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:text="OUR MISSION"
                            android:textColor="@color/luxury_gold"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-light"
                            android:lineSpacingExtra="4dp"
                            android:text="Our mission is to create a peaceful, distraction-free sanctuary where you can reflect on your feelings without judgment. By combining daily mood tracking, empathetic AI companionship, offline journaling, and guided breathing exercises, Kintsugi helps you build resilience and self-compassion every day."
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 5. How Kintsugi Helps Card (28dp Radius) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_features_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/gold_accent_alpha30"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:text="HOW KINTSUGI HELPS"
                            android:textColor="@color/luxury_gold"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical">

                            <!-- Row 1 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_mood_tag_chip"
                                    android:gravity="center"
                                    android:text="🌿"
                                    android:textSize="18sp" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="Mood Tracking"
                                        android:textColor="@color/text_primary"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-light"
                                        android:text="Record daily emotions and discover wellbeing patterns."
                                        android:textColor="@color/text_secondary"
                                        android:textSize="12sp" />

                                </LinearLayout>

                            </LinearLayout>

                            <!-- Row 2 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_mood_tag_chip"
                                    android:gravity="center"
                                    android:text="✦"
                                    android:textColor="@color/luxury_gold"
                                    android:textSize="18sp" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="AI Companion"
                                        android:textColor="@color/text_primary"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-light"
                                        android:text="Empathetic, judgment-free conversational support 24/7."
                                        android:textColor="@color/text_secondary"
                                        android:textSize="12sp" />

                                </LinearLayout>

                            </LinearLayout>

                            <!-- Row 3 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_mood_tag_chip"
                                    android:gravity="center"
                                    android:text="📝"
                                    android:textSize="18sp" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="Offline-First Journaling"
                                        android:textColor="@color/text_primary"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-light"
                                        android:text="Write private reflections stored safely on your device."
                                        android:textColor="@color/text_secondary"
                                        android:textSize="12sp" />

                                </LinearLayout>

                            </LinearLayout>

                            <!-- Row 4 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_mood_tag_chip"
                                    android:gravity="center"
                                    android:text="🫁"
                                    android:textSize="18sp" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="Breathing Exercises"
                                        android:textColor="@color/text_primary"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-light"
                                        android:text="Calm your nervous system with synchronized visual breathing."
                                        android:textColor="@color/text_secondary"
                                        android:textSize="12sp" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 6. Privacy & Trust Card (28dp Radius) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_privacy_trust"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/gold_accent_alpha30"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:text="PRIVACY &amp; TRUST"
                            android:textColor="@color/luxury_gold"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-light"
                            android:lineSpacingExtra="4dp"
                            android:text="Your emotional sanctuary is personal. All journal entries and mood data are encrypted and remain strictly private to your account. We never sell your personal data."
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 7. Version Information Card (28dp Radius) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_version_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/gold_accent_alpha30"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:text="APPLICATION INFO"
                            android:textColor="@color/luxury_gold"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:text="Kintsugi Mobile v1.0.0 (Build 100)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-light"
                            android:text="Crafted with care for mindfulness and resilience."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 8. Inspirational Footer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="1dp"
                        android:background="@color/gold_accent_alpha30" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="“Every crack tells a story. Every repair makes us stronger.”"
                        android:textColor="@color/luxury_gold"
                        android:textSize="14sp"
                        android:textStyle="italic" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
