<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_achievement"
    android:layout_width="match_parent"
    android:layout_height="125dp"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/gold_accent_alpha30"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <TextView
                android:id="@+id/tv_badge_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_mood_tag_chip"
                android:gravity="center"
                android:text="🌟"
                android:textColor="@color/luxury_gold"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tv_lock_overlay"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_mood_tag_chip"
                android:gravity="center"
                android:text="🔒"
                android:textSize="10sp"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/tv_badge_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            tools:text="First Step" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
