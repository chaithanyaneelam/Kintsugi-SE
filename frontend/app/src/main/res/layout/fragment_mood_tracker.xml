<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Ambient Dark Purple Background (#0D0918) -->
    <com.kintsugi.app.core.ui.widget.AnimatedBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Global Kintsugi Toolbar Component -->
        <com.kintsugi.app.core.ui.widget.KintsugiToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:subtitle="Track &amp; reflect on your emotional journey"
            app:title="Mood Sanctuary" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="100dp">

                <!-- 2. Mood Selection Card ("How are you feeling?") -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mood_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#1A1330"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/glass_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:text="💜"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="How are you feeling?"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Horizontal Mood Selection Cards Carousel -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:clipToPadding="false"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.kintsugi.app.features.moodtracker.ui.components.PremiumMoodCardView
                                    android:id="@+id/card_mood_happy"
                                    android:layout_width="86dp"
                                    android:layout_height="96dp"
                                    android:layout_marginEnd="8dp" />

                                <com.kintsugi.app.features.moodtracker.ui.components.PremiumMoodCardView
                                    android:id="@+id/card_mood_calm"
                                    android:layout_width="86dp"
                                    android:layout_height="96dp"
                                    android:layout_marginEnd="8dp" />

                                <com.kintsugi.app.features.moodtracker.ui.components.PremiumMoodCardView
                                    android:id="@+id/card_mood_anxious"
                                    android:layout_width="86dp"
                                    android:layout_height="96dp"
                                    android:layout_marginEnd="8dp" />

                                <com.kintsugi.app.features.moodtracker.ui.components.PremiumMoodCardView
                                    android:id="@+id/card_mood_angry"
                                    android:layout_width="86dp"
                                    android:layout_height="96dp"
                                    android:layout_marginEnd="8dp" />

                                <com.kintsugi.app.features.moodtracker.ui.components.PremiumMoodCardView
                                    android:id="@+id/card_mood_tired"
                                    android:layout_width="86dp"
                                    android:layout_height="96dp" />
                            </LinearLayout>
                        </HorizontalScrollView>

                        <!-- Reflection Input Box -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:cardBackgroundColor="#241A42"
                            app:cardCornerRadius="16dp"
                            app:strokeColor="@color/glass_card_border"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/et_mood_note"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:gravity="top|start"
                                android:hint="Would you like to share what's on your mind?"
                                android:imeOptions="actionDone"
                                android:inputType="textMultiLine"
                                android:minLines="2"
                                android:padding="14dp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_muted"
                                android:textSize="14sp" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Submit Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_submit_mood"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="14dp"
                            android:text="Log Mood &amp; Reflect ✦"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="#7C3AED"
                            app:cornerRadius="20dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Dynamic AI Response Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_ai_response"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#1A1330"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/glass_card_border"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bottom_navigation_background">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_sparkles"
                                    app:tint="@color/soft_lavender" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.08"
                                android:text="TODAY'S REFLECTION"
                                android:textColor="@color/soft_lavender"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_ai_response_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-regular"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            tools:text="“I hear how unsettled you’re feeling right now. It makes sense to feel this way sometimes.”" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Complete Mood Analytics Dashboard Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mood_analytics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="#1A1330"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/glass_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Analytics Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_journal_filled"
                                app:tint="@color/soft_lavender" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="Mood Analytics"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-regular"
                                    android:text="Understand your emotional journey"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Custom Glass Period Dropdown View (No Material Dropdown) -->
                            <com.kintsugi.app.features.moodtracker.ui.components.CustomPeriodDropdownView
                                android:id="@+id/btn_filter_dropdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <!-- Summary Statistics Cards Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <!-- Stat 1 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                app:cardBackgroundColor="#241A42"
                                app:cardCornerRadius="14dp"
                                app:strokeColor="@color/glass_card_border"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <TextView
                                        android:id="@+id/tv_stat1_value"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:textColor="#C4B5FD"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        tools:text="12" />

                                    <TextView
                                        android:id="@+id/tv_stat1_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:fontFamily="sans-serif-regular"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="10sp"
                                        tools:text="Total Logs" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Stat 2 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="3dp"
                                app:cardBackgroundColor="#241A42"
                                app:cardCornerRadius="14dp"
                                app:strokeColor="@color/glass_card_border"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <TextView
                                        android:id="@+id/tv_stat2_value"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:textColor="#C4B5FD"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        tools:text="Calm 😌" />

                                    <TextView
                                        android:id="@+id/tv_stat2_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:fontFamily="sans-serif-regular"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="10sp"
                                        tools:text="Most Common" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Stat 3 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                app:cardBackgroundColor="#241A42"
                                app:cardCornerRadius="14dp"
                                app:strokeColor="@color/glass_card_border"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <TextView
                                        android:id="@+id/tv_stat3_value"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:textColor="#C4B5FD"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        tools:text="85%" />

                                    <TextView
                                        android:id="@+id/tv_stat3_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:fontFamily="sans-serif-regular"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="10sp"
                                        tools:text="Consistency" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- Chart 1: Mood Timeline Line Chart -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="MOOD TREND"
                            android:textColor="@color/soft_lavender"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.kintsugi.app.features.moodtracker.ui.components.MoodHistoryChartView
                            android:id="@+id/chart_view"
                            android:layout_width="match_parent"
                            android:layout_height="190dp"
                            android:layout_marginTop="8dp" />

                        <!-- Chart 2: Mood Frequency Bar Chart -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="MOOD FREQUENCY"
                            android:textColor="@color/soft_lavender"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.kintsugi.app.features.moodtracker.ui.components.MoodFrequencyBarChartView
                            android:id="@+id/bar_chart_frequency"
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            android:layout_marginTop="8dp" />

                        <!-- Chart 3: Emotional Distribution Donut Chart -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="EMOTIONAL DISTRIBUTION"
                            android:textColor="@color/soft_lavender"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.kintsugi.app.features.moodtracker.ui.components.MoodDistributionDonutChartView
                            android:id="@+id/donut_chart_distribution"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="8dp" />

                        <!-- Chart 4: Weekly Consistency Heatmap -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="LOGGING CONSISTENCY"
                            android:textColor="@color/soft_lavender"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.kintsugi.app.features.moodtracker.ui.components.MoodHeatmapView
                            android:id="@+id/heatmap_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="10dp" />

                        <!-- Automated AI Insight Callout Box -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:cardBackgroundColor="#241A42"
                            app:cardCornerRadius="14dp"
                            app:strokeColor="@color/glass_card_border"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="12dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginEnd="8dp"
                                    android:src="@drawable/ic_sparkles"
                                    app:tint="@color/soft_lavender" />

                                <TextView
                                    android:id="@+id/tv_chart_insight_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-regular"
                                    android:text="Insight: You've been mostly calm this week. Keep nurturing these positive moments."
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Mood Timeline Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_home"
                        app:tint="@color/soft_lavender" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Mood Timeline"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_timeline_view_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:text="View All ›"
                        android:textColor="@color/soft_lavender"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Timeline List RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_mood_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_mood_history_entry" />

                <!-- Empty Timeline State View -->
                <LinearLayout
                    android:id="@+id/layout_empty_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_mood_filled"
                        app:tint="@color/soft_lavender" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="No reflections yet"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-regular"
                        android:text="Your emotional journey begins with your first check-in."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_empty_log_first"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Log First Mood"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="#7C3AED"
                        app:cornerRadius="18dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
