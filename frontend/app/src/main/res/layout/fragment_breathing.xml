<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:fitsSystemWindows="true">

    <!-- Animated Particle & Gradient Background Surface -->
    <com.kintsugi.app.core.ui.widget.AnimatedBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.kintsugi.app.core.ui.widget.FloatingParticlesView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Global Kintsugi Toolbar Component -->
        <com.kintsugi.app.core.ui.widget.KintsugiToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:subtitle="Find stillness through your breath"
            app:title="Mindfulness" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="48dp">

                <!-- Greeting Header -->
                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    tools:text="Take a moment to breathe." />

                <!-- Current Phase Label -->
                <TextView
                    android:id="@+id/tv_phase_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:textColor="@color/luxury_gold"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="Inhale" />

                <!-- Hero Centered Breathing Circle View (~300dp) -->
                <com.kintsugi.app.features.breathing.ui.BreathingCircleView
                    android:id="@+id/breathing_circle"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:layout_marginVertical="20dp" />

                <!-- Session Remaining Timer -->
                <TextView
                    android:id="@+id/tv_session_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="05:00 REMAINING" />

                <!-- Cycle Counter -->
                <TextView
                    android:id="@+id/tv_cycle_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Cycle 1" />

                <!-- Segmented Breathing Preset Selector -->
                <LinearLayout
                    android:id="@+id/preset_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_mood_tag_chip"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/preset_beginner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="Beginner"
                        android:textColor="@color/luxury_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/preset_relax"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="Relax"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/preset_focus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="Focus"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/preset_sleep"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="Sleep"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Primary Action Button (Start / Pause / Resume) -->
                <com.kintsugi.app.core.ui.widget.PrimaryGradientButton
                    android:id="@+id/btn_primary_action"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Begin Session ✦" />

                <!-- Secondary Button (End Session) -->
                <com.kintsugi.app.core.ui.widget.SecondaryButton
                    android:id="@+id/btn_end_session"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="End Session"
                    android:visibility="gone" />

                <!-- Daily Inspiration Footer -->
                <TextView
                    android:id="@+id/tv_motivational_footer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/luxury_gold"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    tools:text="Every breath is a fresh beginning." />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
