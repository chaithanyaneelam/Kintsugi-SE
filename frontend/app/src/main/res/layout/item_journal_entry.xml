<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_journal_entry"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#1A1232"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#2E224D"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Left Circular Themed Icon Container -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_round_icon_btn">

            <ImageView
                android:id="@+id/iv_journal_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_chat"
                app:tint="#A855F7" />

        </FrameLayout>

        <!-- Right Side Main Entry Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top Title & Date Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_journal_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Hi" />

                <TextView
                    android:id="@+id/tv_journal_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:textColor="#B794F6"
                    android:textSize="11sp"
                    tools:text="TODAY • 11:52 PM" />

                <ImageView
                    android:id="@+id/iv_pin_ic"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_pin"
                    app:tint="#A855F7" />

            </LinearLayout>

            <!-- Body Snippet Preview -->
            <TextView
                android:id="@+id/tv_journal_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="#B7B3C9"
                android:textSize="13sp"
                tools:text="Helloo" />

            <!-- Mood Tag & Reading Time Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_mood_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_button"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="#A855F7"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Calm" />

                <TextView
                    android:id="@+id/tv_read_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#8B88A0"
                    android:textSize="11sp"
                    tools:text="• 1 min read (1 words)" />

            </LinearLayout>

            <!-- Footer Divider Line & Action Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_encryption_ic"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@string/app_name"
                    android:src="@android:drawable/ic_lock_lock"
                    app:tint="#8B88A0" />

                <TextView
                    android:id="@+id/tv_security_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Encrypted"
                    android:textColor="#8B88A0"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:text="|"
                    android:textColor="#3B2A5E"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/btn_delete_journal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_trash"
                        app:tint="#FB7185" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Delete"
                        android:textColor="#FB7185"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
