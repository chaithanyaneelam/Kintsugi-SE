<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Deep Dark Purple Background -->
    <item>
        <color android:color="#0F0B18" />
    </item>

    <!-- Top Left Deep Purple to Center Indigo Linear Transition -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#2A1850"
                android:centerColor="#1B1430"
                android:startColor="#0F0B18"
                android:type="linear" />
        </shape>
    </item>

    <!-- Center Soft Radial Purple Ambient Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.3"
                android:endColor="#000F0B18"
                android:gradientRadius="400dp"
                android:startColor="#268B5CF6"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
