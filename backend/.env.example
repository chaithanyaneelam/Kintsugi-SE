# =============================================================================
# Kintsugi Backend Environment Configuration Template
# Copy this file to '.env' before starting the FastAPI server
# =============================================================================

# Application Core Settings
PROJECT_NAME="Kintsugi Mental Health & Wellness Companion"
API_V1_STR="/api/v1"
ENV="development"
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# Authentication & JWT Security
# Generate a secure random key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace_with_a_secure_32_byte_hex_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MariaDB / MySQL Database Configuration (XAMPP or Standalone)
MYSQL_SERVER="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DB="kintsugi_db"
DATABASE_URL="mysql+pymysql://root:@localhost:3306/kintsugi_db"

# Redis & Celery Background Task Queue
REDIS_URL="redis://localhost:6379/1"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# AI / Mistral AI Integration
MISTRAL_API_KEY="your_mistral_ai_api_key_here"
MISTRAL_MODEL="mistral-small-latest"

# Emergency & Crisis Alerting
EMERGENCY_CONTACT_EMAIL="support@kintsugi.example.com"
CRISIS_ESCALATION_WEBHOOK=""

# Transactional Email (Gmail SMTP Setup)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="app.services.v1@gmail.com"
SMTP_PASSWORD="your_16_character_app_password_here"
SMTP_FROM="app.services.v1@gmail.com"
